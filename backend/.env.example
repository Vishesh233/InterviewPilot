# Copy this file to backend/.env and fill in real values locally.
# backend/.env is ignored by Git — never commit real credentials.

# MongoDB connection string used by the API server.
MONGODB_URI=

# Port the API server listens on.
PORT=5000

# Secret used to sign and verify JWT sessions. Use a long random value.
JWT_SECRET=

# OpenRouter API key used by the LLM adapter (model: openrouter/free).
OPENROUTER_API_KEY=
