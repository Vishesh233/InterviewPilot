# Copy this file to backend/.env and fill in real values locally.
# backend/.env is ignored by Git — never commit real credentials.

# MongoDB connection string used by the API server.
MONGODB_URI=

# Port the API server listens on.
PORT=5000

# Secret used to sign and verify JWT sessions. Use a long random value.
JWT_SECRET=

# Google Gemini API key — the PRIMARY LLM provider.
# Read from process.env only; never log, print, or commit it.
GEMINI_API_KEY=

# Gemini model id. Optional: when unset or blank the adapter uses its built-in
# default (gemini-3.5-flash-lite). Change it with an environment change only.
GEMINI_MODEL=

# Optional Gemini thinking control: empty = model default; MINIMAL/LOW/MEDIUM/HIGH = thinkingLevel; an integer = thinkingBudget tokens (0 disables, -1 automatic).
GEMINI_THINKING=

# Optional per-model thinking overrides, comma-separated model=SETTING pairs
# (same values as GEMINI_THINKING; an empty SETTING sends no thinkingConfig).
# Models not listed use GEMINI_THINKING. Example:
# GEMINI_THINKING_OVERRIDES=gemini-3.5-flash=MINIMAL,gemini-3.1-flash-lite=MINIMAL
GEMINI_THINKING_OVERRIDES=

# Gemini models tried in order after GEMINI_MODEL. A model is left only after
# its transient retries are exhausted, or immediately on a 404 model-not-found.
# Unset = the built-in list below; set to empty to disable Gemini fallbacks.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite

# OpenRouter is the LAST entry of the fallback chain, used only when every
# Gemini model failed transiently (rate limit / overloaded / timeout / network).
# Remove these two variables to disable it entirely.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Retries per model for transient errors (timeout, 499, 503, 504, 429, network
# reset). Default 3. Permanent errors are never retried.
LLM_MAX_RETRIES=3

# Base delay for exponential backoff with full jitter, in ms. Default 2000;
# each delay is capped at 30000 ms. A Retry-After hint replaces it (capped).
LLM_RETRY_BASE_MS=2000

# How long a model that answered 503/504/499 is skipped, in ms (in memory,
# per process). Ignored for the last model left in the chain. Default 60000.
LLM_COOLDOWN_MS=60000

# Per-call timeout for every model in the chain, in ms. Default 90000.
LLM_TIMEOUT_MS=90000

# Background generation jobs (POST /api/interview-prep, /api/kits/:id/gaps and
# /api/kits/:id/regenerate answer 202 { jobId }; poll GET /api/jobs/:id).
# Jobs that may run at the same time in this process; extra jobs stay queued.
JOB_CONCURRENCY=2

# Wall-clock limit for one processing run of a job, in ms (including automatic
# resume waits). A job that exceeds it fails with JOB_TIMEOUT. Default 900000.
JOB_TIMEOUT_MS=900000

# Waits before each automatic resume after a stage failed transiently even
# after the whole model chain, in ms, comma-separated. At most 2 automatic
# resumes per run. Default 20000,60000.
JOB_RESUME_DELAYS_MS=20000,60000
